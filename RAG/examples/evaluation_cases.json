      "expected_terms": ["不能", "权限"]
    },
    {
      "id": "bill-refunds",
      "question": "账单分析如何处理退款、本人转账和重复交易？",
      "expected_status": "grounded",
      "expected_terms": ["退款", "重复"]
    },
    {
      "id": "subscription-savings",
      "question": "订阅取消后未来节约能否计入当前余额？",
      "expected_status": "grounded",
      "expected_terms": ["未来", "当前余额"]
    },
    {
      "id": "transfer-parameters",
      "question": "转账参数变更后需要重新确认吗？",
      "expected_status": "grounded",
      "expected_terms": ["参数", "确认"]
