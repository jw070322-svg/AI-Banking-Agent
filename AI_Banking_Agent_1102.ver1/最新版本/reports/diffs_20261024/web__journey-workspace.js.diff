 function scenarioCards(){return `<section class="scene-cards-area" aria-labelledby="scene-cards-title"><div class="scene-cards-heading"><div><span class="eyebrow">BANKING CAPABILITIES</span><h2 id="scene-cards-title">六个场景，一个清楚的入口。</h2><p>保留六类核心能力；卡片状态说明当前演示范围。</p></div><span class="scene-blueprint-label">六类场景 · 能力蓝本</span></div><div class="scene-cards-grid">${sceneCards.map((c,i)=>`<article class="scene-card" data-scene="${c.id}"><div class="scene-card-top"><span class="scene-card-icon">${icon(c.icon)}</span><span class="scene-card-number">0${i+1}</span>${tag(c.state,c.tone)}</div><h3>${c.title}</h3><p class="scene-card-capability">${c.capability}</p><p class="scene-card-note">${c.note}</p><div class="scene-card-actions">${c.action?button(c.cta+' '+icon('arrow'),c.action,'button secondary small'):button(c.cta+' '+icon('arrow'),'scene-info','button secondary small',`data-id="${c.id}"`)}${c.action?button('能力说明','scene-info','text-link',`data-id="${c.id}"`):''}</div></article>`).join('')}</div><div class="scene-extras"><div><b>已有增强功能</b><p>在六类场景之外继续保留，辅助比较、授权与核对。</p></div><div>${button('资金预演','preview','button secondary small')}${button('授权中心','permissions','button secondary small')}${button('决策回放','tasks','button secondary small')}</div></div></section>`;}
 function overview(){const s=bank.state,summary=bank.summary(),inProgress=s.operations.filter(o=>['awaiting_confirmation','unknown','processing'].includes(o.status));return `<div class="overview-grid"><section class="card asset-hero"><div class="hero-label"><span>账户资产总额</span>${tag('CNY · 模拟账本','dark')}</div><div class="hero-amount">${fmt(bank.total())}</div><div class="hero-bottom"><div><small>可用资金</small><b>${fmt(s.available)}</b></div><div><small>持仓本金</small><b>${fmt(s.positions.reduce((a,p)=>a+p.amount,0))}</b></div>${button('查看持仓 '+icon('arrow'),'holdings','button light small')}</div><div class="orbit" aria-hidden="true"></div></section><section class="card goal-summary"><div class="card-kicker">NEXT ON YOUR CALENDAR</div><h2>给下一步，<br>留好余地。</h2><div class="inline-stat"><span>${s.goal.months} 个月后必要用款</span><b>${fmt(s.goal.need)}</b></div><div class="inline-stat"><span>独立应急金</span><b>${fmt(s.goal.emergency)}</b></div>${button('调整资金计划 '+icon('arrow'),'plan','text-link')}</section><section class="card overview-spend">${sectionHead('THIS MONTH','本月收支','2026 年 10 月 · 已记账样本',button('分析账单 '+icon('arrow'),'analyze-overview','text-link'))}<div class="metrics three">${metric('收入',fmt(summary.income),'本地账单汇总')}${metric('支出',fmt(summary.expense),'含订阅 '+fmt(16900))}${metric('结余',fmt(summary.net),'不代表未来固定结余','positive')}</div><div class="category-bars">${Object.entries(summary.categories).sort((a,b)=>b[1]-a[1]).slice(0,4).map(([k,v])=>`<div><span>${labels[k]}</span><div><i style="width:${v/summary.expense*100}%"></i></div><b>${fmt(v)}</b></div>`).join('')}</div></section><section class="card overview-action"><div class="card-kicker">A LITTLE MORE ROOM</div><h3>把选择看清楚。</h3><p>从可用资金中先预留必要用款和应急金，再比较期限与流动性。</p><div class="allocation-number"><span>当前可配置上限</span><b>${fmt(bank.capacity())}</b></div>${button('进入理财 '+icon('arrow'),'wealth','button primary')}<small>低风险不等于无风险 · 不展示虚构收益</small></section><section class="card overview-sub">${sectionHead('RECURRING PAYMENTS','订阅与周期扣费','先核实需要，再决定保留或取消。',button('管理订阅','subscriptions','text-link'))}<div class="sub-mini">${s.subscriptions.map(x=>`<button data-action="subdetail" data-id="${x.id}"><span class="service-logo ${x.id}">${x.name[0]}</span><span>${x.name}<small>${x.status==='cancelled'?'已取消续费':x.reviewed?'已核实':'待核实'}</small></span><b>${fmt(x.amount)}<small>/月</small></b>${icon('arrow')}</button>`).join('')}</div><div class="footnote">已确认减少的未来月支出 ${fmt(bank.monthlySaved())}，不增加当前余额。</div></section><section class="card overview-tasks">${sectionHead('YOUR NEXT ACTION','待办与任务',null,button('全部记录','tasks','text-link'))}${inProgress.length?inProgress.map(o=>`<button class="task-mini" data-action="opdetail" data-id="${o.id}"><span>${tag(status[o.status],o.status==='unknown'?'warning':'purple')}<b>${esc(o.name)}</b></span><span>${icon('arrow')}</span></button>`).join(''):`<div class="quiet-state">${icon('check')}<div><b>没有待确认操作</b><p>分析、比较产品不会自动执行金融操作。</p></div></div>`}<div class="task-controls">${button('查看授权','permissions','button secondary small')}${button('试试资金预演','preview','button secondary small')}</div></section></div>${scenarioCards()}`;}
