  "patches": [
    {
      "branch": "eva / 模拟银行接口与风控（卡管理后端主责）",
      "rationale": "卡状态会直接改变转账可执行性，必须由服务端统一检查；页面禁用按钮不足以保护另一条 API。旧版权限检查也缺少 24 小时到期判断。",
      "targets": [
        {
          "file": "first_agent/service.py",
          "change": "require 增加 consentExpiresAt；authorize.cards 仅接受 bool；策略版本升为 integrated-demo-1.1，使旧策略确认不能继续执行。"
        },
        {
          "file": "first_agent/service.py",
          "change": "bound_hash 加入付款卡；check_transfer_limits 从共享交易记录累计当日转账，并使用 eva 单笔/日硬限额；transfer_policy 检查默认卡的 active 状态及剩余额度。"
        },
        {
          "file": "first_agent/service.py",
          "change": "apply_transfer 同时更新卡片 spent 与 externalOut；初始资产基准不再随出账缩减，使可用资金+持仓+对外转出保持守恒。"
        },
        {
          "file": "first_agent/service.py",
          "change": "红色操作先检查服务端断言期限和绑定，再执行引擎；避免过期断言仅返回笼统的引擎拒绝。失败不扣款，未知结果仍阻止新金融写入。"
        },
        {
          "file": "tests/test_update.py",
          "change": "覆盖两条转账路径共享限额、挂失禁止交易、权限类型、过期、重放、旧状态迁移及未知结果只结算一次。"
        }
      ]
    },
